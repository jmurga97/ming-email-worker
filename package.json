{
  "name": "ming-email-worker",
  "description": "Internal multi-product transactional email service for Cloudflare Workers",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "wrangler dev --port 8788 --inspector-port 9231",
    "email:dev": "email dev --dir src/shared/templates",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "check": "tsc --noEmit",
    "test": "bun test",
    "lint": "prettier --write . && eslint . --fix"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.3.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "hono": "^4.11.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260502.0",
    "@eslint/js": "^9.39.1",
    "@react-email/ui": "^6.5.0",
    "@types/bun": "^1.3.6",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.6.0",
    "prettier": "^3.6.2",
    "react-email": "^6.0.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "wrangler": "^4.60.0"
  },
  "packageManager": "bun@1.3.6"
}
